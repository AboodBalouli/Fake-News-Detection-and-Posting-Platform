{
  "name": "fake-news-platform",
  "version": "1.0.0",
  "description": "A full-stack fake news detection and posting platform",
  "scripts": {
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "build": "cd frontend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix",
    "clean": "npm run clean:frontend && npm run clean:backend",
    "clean:frontend": "cd frontend && npm run clean",
    "clean:backend": "cd backend && rm -rf __pycache__ *.pyc",
    "setup:dev": "npm run install:all && npm run setup:env",
    "setup:env": "echo 'Please copy backend/.env.example to backend/.env and configure your settings'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "react",
    "fastapi",
    "postgresql",
    "typescript",
    "news",
    "full-stack"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/fake-news-platform.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}